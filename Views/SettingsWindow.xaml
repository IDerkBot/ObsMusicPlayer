<Window
    x:Class="ObsMusicPlayer.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Настройки"
    Width="500"
    Height="300"
    Background="#1c1c1c"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20">
        <TextBlock
            Margin="0,0,0,20"
            FontSize="20"
            FontWeight="Bold"
            Foreground="White"
            Text="Настройки" />

        <CheckBox
            Margin="0,10"
            FontSize="14"
            Foreground="White"
            IsChecked="{Binding IsAutoStartEnabled, Mode=TwoWay}">
            <TextBlock Text="Запускать при запуске Windows" />
        </CheckBox>

        <Button
            Margin="0,20,0,0"
            Padding="20,8"
            HorizontalAlignment="Right"
            Click="CloseButton_Click"
            Content="Закрыть" />
    </StackPanel>
</Window>